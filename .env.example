# ===== 应用 =====
SERVER_PORT=8081

# ===== PostgreSQL（容器内数据库，向量扩展已启用）=====
# POSTGRES_PORT 为宿主机暴露端口，容器内部固定 5432。
# 业务表由 Flyway 在应用首次启动时自动创建，无需手工建表。
POSTGRES_DB=team_collaboration_agent
POSTGRES_USER=team_collaboration_agent
POSTGRES_PASSWORD=change-me
POSTGRES_PORT=5432

# ===== 对话模型（OpenAI 兼容接口）=====
CHAT_MODEL_BASE_URL=https://api.minimaxi.com
CHAT_MODEL_API_KEY=replace-me
CHAT_MODEL_NAME=MiniMax-M2.7

# ===== 向量模型（OpenAI 兼容接口）=====
EMBEDDING_MODEL_BASE_URL=https://api.siliconflow.cn
EMBEDDING_MODEL_API_KEY=replace-me
EMBEDDING_MODEL_NAME=BAAI/bge-m3

# ===== 重排模型（OpenAI 兼容 /v1/rerank 接口）=====
RERANK_MODEL_BASE_URL=http://localhost:8083
RERANK_MODEL_NAME=bge-reranker-v2-m3
